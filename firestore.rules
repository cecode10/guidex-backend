rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // Content writes require a signed-in user. Email verification is enforced in
    // the app AuthGuard for password accounts — token claim checks here were
    // blocking legitimate SSO / stale-token sessions from follow + check-in.
    function isSignedInAndVerified() {
      return isSignedIn();
    }

    // Who may follow this user (mirrors app `ProfilePrivacyService`).
    function effectiveWhoCanFollowMe(data) {
      let raw = data == null ? 'everyone' : (
        (data.settings is map
            && 'whoCanFollowMe' in data.settings
            && data.settings.whoCanFollowMe is string)
          ? data.settings.whoCanFollowMe
          : (data.keys().hasAny(['whoCanFollowMe']) && data.whoCanFollowMe is string
              ? data.whoCanFollowMe
              : 'everyone')
      );
      return (raw == 'everyone' || raw == 'people_i_follow' || raw == 'no_one') ? raw : 'everyone';
    }

    // Who may see this user's check-ins (mirrors app `ProfilePrivacyService`).
    function effectiveWhoCanSeeMyCheckIns(data) {
      let raw = data == null ? 'everyone' : (
        (data.settings is map
            && 'whoCanSeeMyCheckIns' in data.settings
            && data.settings.whoCanSeeMyCheckIns is string)
          ? data.settings.whoCanSeeMyCheckIns
          : (data.keys().hasAny(['whoCanSeeMyCheckIns']) && data.whoCanSeeMyCheckIns is string
              ? data.whoCanSeeMyCheckIns
              : 'everyone')
      );
      return (raw == 'everyone' || raw == 'people_i_follow' || raw == 'no_one') ? raw : 'everyone';
    }

    // [followerId] adds users/{followerId}/friends/{targetId}; target must allow it.
    function followCreateAllowed(targetUserData, followerId, targetId) {
      let policy = effectiveWhoCanFollowMe(targetUserData);
      return policy == 'everyone'
        || (policy == 'people_i_follow'
            && exists(/databases/$(database)/documents/users/$(targetId)/friends/$(followerId)));
    }

    // Viewer may read author check-ins when owner, everyone, or author follows viewer.
    function checkInReadAllowed(authorId, authorData) {
      return request.auth.uid == authorId
        || effectiveWhoCanSeeMyCheckIns(authorData) == 'everyone'
        || (effectiveWhoCanSeeMyCheckIns(authorData) == 'people_i_follow'
            && exists(/databases/$(database)/documents/users/$(authorId)/friends/$(request.auth.uid)));
    }

    // Users Collection
    match /users/{userId} {
      // Anyone logged in can read user profiles (needed for search and feed)
      allow read: if isSignedIn();
      // Users can only update their own profile/settings
      allow write: if isSignedIn() && request.auth.uid == userId;

      // Friends Subcollection
      match /friends/{friendId} {
        // Anyone logged in can see who someone follows
        allow read: if isSignedIn();
        allow delete: if isSignedInAndVerified() && request.auth.uid == userId;
        allow update: if isSignedInAndVerified() && request.auth.uid == userId;
        allow create: if isSignedInAndVerified()
          && request.auth.uid == userId
          && followCreateAllowed(
            get(/databases/$(database)/documents/users/$(friendId)).data,
            userId,
            friendId
          );
      }

      // Explore bookmarks
      match /bookmarks/{bookmarkId} {
        allow read: if isSignedIn();
        allow write: if isSignedInAndVerified() && request.auth.uid == userId;
      }

      // Curated trips built from saved places
      match /trips/{tripId} {
        allow read: if isSignedIn();
        allow write: if isSignedInAndVerified() && request.auth.uid == userId;
      }

      // FCM device tokens for push notifications (one doc per device).
      match /fcmTokens/{tokenId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.token is string;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Checkmarks check-ins
      match /checkins/{checkInId} {
        allow read: if isSignedIn()
          && checkInReadAllowed(
            userId,
            get(/databases/$(database)/documents/users/$(userId)).data
          );
        // Owner create/delete: AuthGuard already gates unverified password users.
        // Keep this as isSignedIn() so token claim quirks cannot block posting.
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
        // Likes update likeCount when the viewer is allowed to see the check-in.
        allow update: if isSignedIn()
          && checkInReadAllowed(
            userId,
            get(/databases/$(database)/documents/users/$(userId)).data
          );

        match /likes/{likerId} {
          allow read: if isSignedIn()
            && checkInReadAllowed(
              userId,
              get(/databases/$(database)/documents/users/$(userId)).data
            );
          allow write: if isSignedIn()
            && request.auth.uid == likerId
            && checkInReadAllowed(
              userId,
              get(/databases/$(database)/documents/users/$(userId)).data
            );
        }
      }
    }

    // Collection-group queries on any `friends` subcollection
    // (e.g. followers lookup via collectionGroup('friends')).
    match /{document=**}/friends/{friendDocId} {
      allow read: if isSignedIn();
    }

    // Collection-group queries on any `likes` subcollection
    // (e.g. CheckmarksService.ensureLikesBound() via collectionGroup('likes')).
    match /{document=**}/likes/{likeDocId} {
      allow read: if isSignedIn();
    }

    // Posts Collection
    match /posts/{postId} {
      // Anyone logged in can read the feed
      allow read: if isSignedIn();
      // Anyone logged in can create a post
      allow create: if isSignedInAndVerified()
        && request.resource.data.authorId == request.auth.uid;
      // Only the author can delete their post
      allow delete: if isSignedInAndVerified()
        && resource.data.authorId == request.auth.uid;
      // Updates are generally restricted, except for incrementing like counts (handled via transactions)
      allow update: if isSignedInAndVerified();

      // Likes Subcollection
      match /likes/{userId} {
        allow read: if isSignedIn();
        // Users can only add/remove their own likes
        allow write: if isSignedInAndVerified() && request.auth.uid == userId;
      }
    }

    // Shared place-image cache. Written exclusively by the
    // `resolvePlaceImage` Cloud Function (Admin SDK bypasses these rules);
    // clients may only read the resolved cover/metadata.
    match /place-images/{placeKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Shared geo-location cache for nearby popular places. Written exclusively
    // by `resolveNearMePopular` / `resolveGlobalSearchPopular`; clients may only read.
    match /geo-location/{locationKey} {
      allow read: if isSignedIn();
      allow write: if false;

      match /popularAroundList/{placeId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Support-only audit trail for deleted accounts (written by Admin SDK).
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

    // Customer Feedback Collection
    match /customer-feedback/{feedbackId} {
      // Anyone logged in can submit feedback
      allow create: if isSignedInAndVerified()
        && request.resource.data.customerId == request.auth.uid;

      // No one can read, update, or delete feedback from the client app
      allow read, update, delete: if false;
    }
  }
}
