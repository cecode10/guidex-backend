# Firebase params for project guidex-afc30 (loaded on deploy).
# Not a secret — only the VPC connector resource name.
SIGHTSEEING_VPC_CONNECTOR=projects/guidex-afc30/locations/europe-west3/connectors/sightseeing-sql

# Zoho SMTP for onUserReportCreated. Password is Secret Manager: SMTP_PASSWORD.
# Host: smtp.zoho.eu (EU) or smtp.zoho.com (US). Paid custom domain: smtppro.zoho.*
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=info@kudosaitech.com
SMTP_FROM=Ramblex <support@kudosaitech.com>
