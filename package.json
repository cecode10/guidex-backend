{
    "name": "ramblex-backend",
    "version": "1.0.0",
    "type": "module",
    "main": "index.mjs",
    "sideEffects": false,
    "engines": {
        "node": "24"
    },
    "scripts": {
        "deploy:textPrompt": "firebase deploy --only functions:textPrompt",
        "deploy:imageAnnotation": "firebase deploy --only functions:imageAnnotation",
        "deploy:imageRecognition": "firebase deploy --only functions:imageRecognition",
        "deploy:textToSpeech": "firebase deploy --only functions:textToSpeech",
        "deploy:deleteAccount": "firebase deploy --only functions:deleteAccount",
        "deploy:onUserProfileUpdate": "firebase deploy --only functions:onUserProfileUpdate",
        "deploy:resolvePlaceImage": "firebase deploy --only functions:resolvePlaceImage",
        "deploy:resolveNearMePopular": "firebase deploy --only functions:resolveNearMePopular",
        "deploy:resolveGlobalSearchPopular": "firebase deploy --only functions:resolveGlobalSearchPopular",
        "deploy:resolveNearbyPlaces": "firebase deploy --only functions:resolveNearbyPlaces",
        "deploy:generateWalkingTrip": "firebase deploy --only functions:generateWalkingTrip",
        "deploy:resolvePlaceCity": "firebase deploy --only functions:resolvePlaceCity",
        "deploy:onCheckinLikeCreated": "firebase deploy --only functions:onCheckinLikeCreated",
        "deploy:onCheckinCreated": "firebase deploy --only functions:onCheckinCreated",
        "deploy:onFollowerAdded": "firebase deploy --only functions:onFollowerAdded",
        "deploy:ensureSightseeingByQid": "firebase deploy --only functions:ensureSightseeingByQid",
        "deploy:firestore": "firebase deploy --only firestore",
        "deploy:storage": "firebase deploy --only storage",
        "deploy:batch:functions": "firebase deploy --only functions",
        "deploy:batch:explorePopular": "firebase deploy --only functions:resolveNearMePopular,functions:resolveGlobalSearchPopular",
        "deploy:batch:notifications": "firebase deploy --only functions:onCheckinLikeCreated,functions:onCheckinCreated,functions:onFollowerAdded",
        "deploy:batch:sightseeing": "firebase deploy --only functions:resolveNearMePopular,functions:resolveGlobalSearchPopular,functions:resolveNearbyPlaces,functions:generateWalkingTrip,functions:ensureSightseeingByQid",
        "serve": "firebase emulators:start --only functions",
        "logs": "firebase functions:log",
        "test": "vitest run",
        "test:watch": "vitest",
        "script:sightseeing:migrate": "node -e \"import('fs').then(async fs=>{const{sightseeingQuery,closeSightseeingPool}=await import('./sightseeing-db.mjs');await sightseeingQuery(fs.readFileSync('db/001_sightseeing.sql','utf8'));await closeSightseeingPool();console.log('migrated');})\"",
        "script:sightseeing:seed-qids": "node scripts/seed-sightseeing-from-qids.mjs",
        "script:sightseeing:seed-qids:dry-run": "node scripts/seed-sightseeing-from-qids.mjs --dry-run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/pg": "^8.20.0",
        "eslint": "^10.6.0",
        "firebase-tools": "^15.22.3",
        "globals": "^17.7.0",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "firebase-admin": "^13.10.0",
        "firebase-functions": "^7.2.5",
        "openai": "^6.45.0",
        "pg": "^8.22.0",
        "sharp": "^0.35.2"
    }
}
